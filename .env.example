# AI chat: set one authentication method. Vercel supplies VERCEL_OIDC_TOKEN
# automatically for connected deployments.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
AI_MODEL=openai/gpt-5.6-terra

# Optional persisted profile, brand, investment, and rate-limit data.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional stock data integrations.
POLY_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Optional Google sign-in. Generate a strong AUTH_SECRET for production.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional client integrations.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
